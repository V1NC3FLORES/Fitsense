# ============================================================
#  Application configuration
# ============================================================
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file.
# ============================================================

# Database config
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_system
DB_USER=root
DB_PASS=

# Optional absolute path outside the web document root; blank uses a private sibling directory.
APP_BACKUP_DIR=
# Optional path to the MySQL client binaries if they are not beside PHP's XAMPP installation.
MYSQL_BIN_DIR=

# SMTP config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# ============================================================
#  Xendit / payment configuration
# ============================================================
# These are TEST/DEVELOPMENT credentials. Do not enable live
# payments until the webhook endpoint is public HTTPS and the
# whole flow has been verified.
# ============================================================

# Xendit secret API key.
# Test mode keys start with "xnd_development_".
XENDIT_SECRET_KEY=

# Webhook verification token.
# Xendit Dashboard -> Settings -> Developers -> Webhooks -> Verification Token.
# Sent by Xendit in the "x-callback-token" header.
XENDIT_WEBHOOK_TOKEN=

# Base URL of this app (no trailing slash), used to build the
# success/failure return URLs that Xendit redirects the customer back to.
#
# * Leave EMPTY for local XAMPP: the app auto-detects the URL from the
#   incoming request and percent-encodes the path, so a project folder
#   with a space (e.g. "PBL updated") produces a valid URL like:
#       http://localhost/PBL%20updated/PBL
# * Set it explicitly if auto-detection is wrong. The path MUST be
#   percent-encoded (use %20 for spaces):
#       XENDIT_BASE_URL=http://localhost/PBL%20updated/PBL
# * For webhook testing, point it at your public HTTPS tunnel:
#       XENDIT_BASE_URL=https://your-subdomain.ngrok-free.app
XENDIT_BASE_URL=

# Base URL used ONLY for the customer return URLs (success / cancel /
# failure) that Xendit redirects the browser back to. No trailing slash.
#
# Leave EMPTY to reuse the value/auto-detection above (recommended for
# local XAMPP). Set it when the return base must differ from XENDIT_BASE_URL
# (for example when XENDIT_BASE_URL points at an ngrok tunnel).
#
# It must be the full URL of the folder that contains payments.php, with
# the path percent-encoded (use %20 for spaces):
#   XENDIT_RETURN_URL_BASE=http://localhost/PBL%20updated/PBL
XENDIT_RETURN_URL_BASE=

# Optional overrides
XENDIT_API_VERSION=2024-11-11
XENDIT_CURRENCY=PHP
# Set to 1 to log extra diagnostics to the PHP error log (never logs secrets).
XENDIT_DEBUG=0
